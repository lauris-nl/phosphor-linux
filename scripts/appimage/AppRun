#!/usr/bin/env bash
set -euo pipefail

app_dir="$(cd -- "$(dirname -- "$0")" && pwd)"

# The packaged app deliberately does not bundle the RRG client. Honour the
# same explicit override as the repository launchers by making its directory
# visible to Tauri's allowlisted `proxmark3` command lookup.
if [[ -n "${PHOSPHOR_MODERN_PM3_BIN:-}" ]]; then
    if [[ ! -x "$PHOSPHOR_MODERN_PM3_BIN" ]]; then
        printf 'Configured Proxmark3 client is not executable: %s\n' \
            "$PHOSPHOR_MODERN_PM3_BIN" >&2
        exit 1
    fi
    if [[ "$(basename -- "$PHOSPHOR_MODERN_PM3_BIN")" != "proxmark3" ]]; then
        printf 'PHOSPHOR_MODERN_PM3_BIN must point to an executable named proxmark3: %s\n' \
            "$PHOSPHOR_MODERN_PM3_BIN" >&2
        exit 1
    fi
    export PATH="$(dirname -- "$PHOSPHOR_MODERN_PM3_BIN"):$PATH"
fi

find_host_webkit() {
    local ldconfig_bin=""
    local candidate

    for candidate in "$(command -v ldconfig 2>/dev/null || true)" /sbin/ldconfig /usr/sbin/ldconfig; do
        if [[ -n "$candidate" && -x "$candidate" ]]; then
            ldconfig_bin="$candidate"
            break
        fi
    done

    if [[ -n "$ldconfig_bin" ]]; then
        "$ldconfig_bin" -p 2>/dev/null |
            awk '$1 == "libwebkit2gtk-4.1.so.0" && !found { print $NF; found = 1 }'
        return
    fi

    for candidate in \
        /usr/lib/libwebkit2gtk-4.1.so.0 \
        /usr/lib64/libwebkit2gtk-4.1.so.0 \
        /usr/lib/x86_64-linux-gnu/libwebkit2gtk-4.1.so.0 \
        /lib/x86_64-linux-gnu/libwebkit2gtk-4.1.so.0; do
        if [[ -r "$candidate" ]]; then
            printf '%s\n' "$candidate"
            return
        fi
    done
}

host_webkit="$(find_host_webkit)"
if [[ -n "$host_webkit" && "$host_webkit" == /* && -r "$host_webkit" ]]; then
    host_lib_dir="$(dirname -- "$host_webkit")"
    export LD_LIBRARY_PATH="$host_lib_dir${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
    export GDK_BACKEND="${GDK_BACKEND:-x11}"
    exec "$app_dir/usr/bin/phosphor" "$@"
fi

exec "$app_dir/AppRun.wrapped" "$@"
