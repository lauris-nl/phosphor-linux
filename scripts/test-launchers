#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
launcher="$repo_dir/scripts/phosphor"
dev_launcher="$repo_dir/scripts/phosphor-dev"
appimage_apprun="$repo_dir/scripts/appimage/AppRun"
appimage_finalizer="$repo_dir/scripts/finalize-appimage"
test_dir="$(mktemp -d)"
trap 'rm -r -- "$test_dir"' EXIT

bash -n "$launcher" "$dev_launcher" "$appimage_apprun" "$appimage_finalizer"

if grep -q 'PHOSPHOR_MODERN_PM3_BIN\|command -v proxmark3' "$appimage_apprun"; then
    echo "AppImage launcher must leave PM3 discovery to the packaged backend" >&2
    exit 1
fi

if env -u PHOSPHOR_MODERN_PM3_BIN -u PHOSPHOR_PM3_PORT \
    PATH=/usr/bin:/bin "$launcher" >"$test_dir/no-client.out" 2>&1; then
    echo "launcher unexpectedly succeeded without a Proxmark3 client" >&2
    exit 1
fi

if ! grep -q "A current RRG/Iceman proxmark3 client is required" "$test_dir/no-client.out"; then
    echo "launcher did not provide an actionable missing-client error" >&2
    exit 1
fi

printf '#!/usr/bin/env sh\nexit 0\n' >"$test_dir/proxmark3"
chmod +x "$test_dir/proxmark3"

mkdir -p "$test_dir/appimage/usr/bin"
cp "$appimage_apprun" "$test_dir/appimage/AppRun"
printf '#!/usr/bin/env sh\nprintf "packaged backend started\\n"\n' >"$test_dir/appimage/usr/bin/phosphor"
printf '#!/usr/bin/env sh\nprintf "packaged backend started\\n"\n' >"$test_dir/appimage/AppRun.wrapped"
chmod +x "$test_dir/appimage/AppRun" "$test_dir/appimage/AppRun.wrapped" \
    "$test_dir/appimage/usr/bin/phosphor"

appimage_result="$(env -u PHOSPHOR_MODERN_PM3_BIN -u PHOSPHOR_PM3_PORT \
    PATH=/usr/bin:/bin "$test_dir/appimage/AppRun" 2>&1)"
if [[ "$appimage_result" != "packaged backend started" ]]; then
    echo "AppImage launcher still requires launcher-side PM3 configuration" >&2
    exit 1
fi

if PHOSPHOR_MODERN_PM3_BIN="$test_dir/proxmark3" \
    PHOSPHOR_PM3_PORT="$test_dir/missing-reader" \
    "$launcher" >"$test_dir/no-reader.out" 2>&1; then
    echo "launcher unexpectedly succeeded without a PM3 serial device" >&2
    exit 1
fi

if ! grep -q "Proxmark3 serial device is not present" "$test_dir/no-reader.out"; then
    echo "launcher did not provide an actionable missing-reader error" >&2
    exit 1
fi

if grep -R -n -E '/home/[^/]+/|vendor/proxmark3(-legacy)?' \
    "$launcher" "$dev_launcher" "$appimage_apprun" "$appimage_finalizer"; then
    echo "launcher contains a developer-machine path" >&2
    exit 1
fi

echo "portable launcher checks passed"
